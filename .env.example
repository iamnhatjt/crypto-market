# ---------------------------------------------------------------------------
# Crypto Market Dashboard — environment template
#
# Copy this file to `.env.local` and fill in what you need:
#
#     cp .env.example .env.local
#
# Every variable below is OPTIONAL. The app ships with working defaults in
# `.env` and runs against the public CoinGecko endpoint with no key at all.
#
# Notes:
#   - Create React App only exposes variables prefixed REACT_APP_.
#   - Values are inlined at BUILD time, so restart `npm start` after editing.
#   - `.env.local` is gitignored; never put a real key in `.env`.
# ---------------------------------------------------------------------------

# CoinGecko API root.
#   Public / Demo : https://api.coingecko.com/api/v3
#   Pro plan      : https://pro-api.coingecko.com/api/v3
REACT_APP_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional API key. Leave blank to call the public endpoint unauthenticated.
# A key raises the rate limit; get a free Demo key at
# https://www.coingecko.com/en/developers/dashboard
REACT_APP_COINGECKO_API_KEY=

# Header the key is sent under. Demo plans use x-cg-demo-api-key;
# Pro plans use x-cg-pro-api-key (and the Pro base URL above).
REACT_APP_COINGECKO_API_KEY_HEADER=x-cg-demo-api-key

# How many coins to request. The brief asks for the top 20.
REACT_APP_COINS_PER_PAGE=20

# How long a fetched market list stays fresh, in milliseconds.
# Kept short because prices move, but long enough to stay inside the free
# tier's rate limit across reloads.
REACT_APP_CACHE_TTL_MS=60000

# Per-request timeout in milliseconds.
REACT_APP_REQUEST_TIMEOUT_MS=10000
