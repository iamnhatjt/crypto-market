# ---------------------------------------------------------------------------
# Committed DEFAULTS — safe to check in, contains no secrets.
#
# This file exists so `npm install && npm start` works with zero setup.
# Override anything here in `.env.local`, which is gitignored:
#
#     cp .env.example .env.local
#
# See .env.example for what each variable does.
# ---------------------------------------------------------------------------

REACT_APP_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Intentionally blank: the markets endpoint is public.
# Put a real key in .env.local, never here.
REACT_APP_COINGECKO_API_KEY=

REACT_APP_COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
REACT_APP_COINS_PER_PAGE=20
REACT_APP_CACHE_TTL_MS=60000
REACT_APP_REQUEST_TIMEOUT_MS=10000
